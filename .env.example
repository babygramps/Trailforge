# TrailForge Environment Configuration

# Domain (used by Caddy for TLS)
DOMAIN=localhost

# PostgreSQL
POSTGRES_USER=trailforge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trailforge

# API
DATABASE_URL=postgres://trailforge:changeme@trailforge-db:5432/trailforge?sslmode=disable
JWT_SECRET=change-this-to-a-random-secret
API_PORT=8080

# Fitbit OAuth2 (optional)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Satellite tile proxy (optional, pick one)
# SATELLITE_PROVIDER=bing|esri|mapbox
# SATELLITE_API_KEY=
