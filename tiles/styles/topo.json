        "line-width": {
          "stops": [
            [10, 0.5],
            [14, 1.5],
            [18, 3]
          ]
        }
      }
    },
    {
      "id": "contour-line",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 11,
      "filter": ["!=", ["get", "nth_line"], 5],
      "paint": {
        "line-color": "#c4a882",
        "line-width": {
          "stops": [
            [11, 0.3],
            [14, 0.6],
            [18, 0.8]
