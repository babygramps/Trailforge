{
  "version": 8,
  "name": "TrailForge Topo",
  "metadata": {
    "mapbox:autocomposite": false,
    "openmaptiles:version": "3.x"
  },
  "glyphs": "http://localhost:8081/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:8081/styles/topo/sprite",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "http://localhost:8081/data/openmaptiles.json"
    },
    "contours": {
      "type": "vector",
      "url": "http://localhost:8081/data/contours.json"
    },
    "hillshade": {
      "type": "raster",
      "url": "http://localhost:8081/data/hillshade.json",
      "tileSize": 256
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f0ede9"
      }
    },
    {
      "id": "hillshade-raster",
      "type": "raster",
      "source": "hillshade",
      "paint": {
        "raster-opacity": {
          "stops": [
            [0, 0.3],
            [8, 0.25],
            [14, 0.15]
          ]
        },
        "raster-resampling": "linear"
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {
        "fill-color": "#d4e8b8",
        "fill-opacity": {
          "stops": [
            [8, 0.6],
            [14, 0.4]
          ]
        }
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#b5d29c",
        "fill-opacity": {
          "stops": [
            [6, 0.5],
            [10, 0.6],
            [14, 0.45]
          ]
        }
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "nature_reserve"],
      "paint": {
        "fill-color": "#c8e6a0",
        "fill-opacity": {
          "stops": [
            [6, 0.3],
            [10, 0.4],
            [14, 0.35]
          ]
        }
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "minzoom": 8,
      "paint": {
        "fill-color": "#e8e0d8",
        "fill-opacity": {
          "stops": [
            [8, 0.2],
            [14, 0.4]
          ]
        }
      }
    },
    {
      "id": "landuse-cemetery",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "cemetery"],
      "minzoom": 10,
      "paint": {
        "fill-color": "#c4dba2",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a3c7df",
        "fill-antialias": true
      }
    },
    {
      "id": "water-pattern",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "minzoom": 10,
      "paint": {
        "fill-color": "#9dc1da",
        "fill-opacity": 0.6
