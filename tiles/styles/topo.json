      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["==", "class", "river"],
      "paint": {
        "line-color": "#a3c7df",
        "line-width": {
          "stops": [
            [8, 1],
            [12, 2],
            [16, 4]
          ]
        }
      }
    },
    {
      "id": "waterway-stream",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["==", "class", "stream"],
      "minzoom": 10,
      "paint": {
