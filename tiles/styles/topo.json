        "line-opacity": {
          "stops": [
            [11, 0.2],
            [13, 0.35],
            [16, 0.5]
          ]
        }
      }
    },
    {
      "id": "contour-line-index",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 11,
      "filter": ["==", ["get", "nth_line"], 5],
      "paint": {
        "line-color": "#b89870",
        "line-width": {
          "stops": [
            [11, 0.5],
            [14, 1],
            [18, 1.5]
          ]
        },
        "line-opacity": {
          "stops": [
            [11, 0.3],
            [13, 0.5],
            [16, 0.65]
          ]
        }
      }
    },
    {
      "id": "contour-label",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "minzoom": 13,
      "filter": ["==", ["get", "nth_line"], 5],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{height}",
        "text-font": ["Noto Sans Regular"],
        "text-size": {
          "stops": [
            [13, 9],
            [16, 11]
          ]
        },
        "text-rotation-alignment": "map",
        "text-max-angle": 25
      },
      "paint": {
        "text-color": "#a08060",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d9d0c9",
        "fill-opacity": {
          "stops": [
            [13, 0.4],
            [16, 0.7]
